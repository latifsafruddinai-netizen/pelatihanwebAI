<!DOCTYPE html>
<html lang="id" class="h-full scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pelatihan Praktik Membangun Website dengan AI - PT Web Digital Marketing (WDM)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Inter & FontAwesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        wdm: {
                            dark: '#0f172a',
                            primary: '#1e293b',
                            gold: '#d97706',
                            amber: '#f59e0b',
                            soft: '#f8fafc'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Print Styles - A4 Landscape Clean Formal Document */
        @media print {
            @page {
                size: A4 landscape;
                margin: 12mm;
            }
            body {
                background: #ffffff !important;
                color: #000000 !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            body * {
                visibility: hidden;
            }
            #printable-area, #printable-area * {
                visibility: visible;
            }
            #printable-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100% !important;
                background: #ffffff !important;
                border: none !important;
                box-shadow: none !important;
                border-radius: 0 !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            table {
                width: 100% !important;
                border-collapse: collapse !important;
                font-size: 9.5pt !important;
            }
            th, td {
                border: 1px solid #1e293b !important;
                padding: 6px 8px !important;
                color: #000000 !important;
                background: #ffffff !important;
                vertical-align: top !important;
            }
            th {
                background-color: #f1f5f9 !important;
                font-weight: 700 !important;
                text-transform: uppercase !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .print-badge {
                border: none !important;
                background: transparent !important;
                color: #000000 !important;
                padding: 0 !important;
                font-weight: 500 !important;
            }
        }
    </style>
</head>
<body class="text-slate-800 min-h-full flex flex-col selection:bg-amber-500 selection:text-white">

    <!-- ==================== MODAL NOTIFIKASI / BUKTI DAFTAR ==================== -->
    <div id="modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden p-4 no-print">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 max-w-lg w-full shadow-2xl text-center transform transition-all scale-95 opacity-0 max-h-[95vh] overflow-y-auto" id="modal-content">
            <div id="modal-icon" class="w-16 h-16 mx-auto mb-3 rounded-full flex items-center justify-center text-2xl"></div>
            <h3 id="modal-title" class="text-xl font-bold text-slate-900 mb-2"></h3>
            <p id="modal-message" class="text-slate-600 text-sm mb-4 leading-relaxed"></p>
            <div id="modal-summary" class="hidden text-left bg-amber-50/80 border border-amber-200 rounded-xl p-3.5 mb-5 text-xs text-slate-700 space-y-1.5"></div>
            
            <!-- Area Pembayaran QRIS & Akses Download (Tampil Setelah Daftar) -->
            <div id="modal-payment-section" class="hidden space-y-4 mb-5 text-left border-t border-slate-200 pt-4">
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center">
                    <p class="text-xs font-bold text-slate-800 mb-1 uppercase tracking-wider">Scan QRIS ShopeePay (Latif Safruddin)</p>
                    <p class="text-[11px] text-slate-500 mb-3">Silakan scan QRIS di bawah ini untuk pembayaran via ShopeePay, GoPay, OVO, atau Bank apa pun:</p>
                    <div class="inline-block p-2 bg-white border border-slate-300 rounded-xl shadow-sm">
                        <img src="QRIS SHOPEEPAY_2.jpeg" alt="QRIS ShopeePay Latif Safruddin" class="w-48 h-auto mx-auto object-contain rounded-lg" onerror="this.src='https://placehold.co/250x320/0f172a/ffffff?text=QRIS+SHOPEEPAY';">
                    </div>
                    <p class="text-xs font-semibold text-slate-700 mt-2">Nama: Latif Safruddin | (+62)858*****277</p>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">Konfirmasi Pembayaran (Upload Bukti Transfer / Masukkan Ref):</label>
                    <input type="text" id="ref-pembayaran" placeholder="No. Ref / Keterangan Transfer / Catatan..." class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800 focus:outline-none focus:border-amber-500">
                </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-2.5">
                <button id="modal-receipt-btn" onclick="printSingleReceipt()" class="hidden w-full py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold rounded-xl transition text-sm border border-slate-300">
                    <i class="fa-solid fa-print mr-1.5 text-amber-600"></i>Cetak Bukti Daftar
                </button>
                <button onclick="confirmPaymentAndUnlock()" id="modal-confirm-pay-btn" class="hidden w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl transition shadow-md shadow-emerald-600/20 text-sm">
                    <i class="fa-solid fa-circle-check mr-1.5"></i>Konfirmasi &amp; Buka Akses Materi
                </button>
                <button onclick="closeModal()" class="w-full py-2.5 px-4 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-xl transition shadow-md text-sm">
                    Tutup
                </button>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL KONFIRMASI HAPUS ==================== -->
    <div id="confirm-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden p-4 no-print">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 max-w-sm w-full shadow-2xl text-center transform transition-all scale-95 opacity-0" id="confirm-modal-content">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center text-2xl bg-red-100 text-red-600">
                <i class="fa-solid fa-trash-can"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Hapus Data Peserta?</h3>
            <p class="text-slate-600 text-sm mb-6">Apakah Anda yakin ingin menghapus data peserta <span id="delete-target-name" class="font-semibold text-slate-900"></span> dari daftar lokal?</p>
            <div class="flex space-x-3">
                <button onclick="closeConfirmModal()" class="w-1/2 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-xl transition text-sm">Batal</button>
                <button onclick="confirmDelete()" class="w-1/2 py-2.5 bg-red-600 hover:bg-red-500 text-white font-semibold rounded-xl transition shadow-md shadow-red-600/20 text-sm">Ya, Hapus</button>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL LOGIN ADMIN ==================== -->
    <div id="password-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/65 backdrop-blur-sm hidden p-4 no-print">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 max-w-sm w-full shadow-2xl text-center transform transition-all scale-95 opacity-0" id="password-modal-content">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center text-2xl bg-amber-100 text-amber-600 border border-amber-200">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-1">Akses Khusus Admin WDM</h3>
            <p class="text-slate-500 text-xs mb-5">Masukkan kata sandi admin untuk melihat, mengunduh, dan mencetak data peserta.</p>
            <form onsubmit="verifyAdminPassword(event)" class="space-y-4 text-left">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-key text-xs"></i>
                    </span>
                    <input type="password" id="admin-password-input" required placeholder="Masukkan kata sandi admin..." 
                        class="w-full pl-10 pr-10 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition text-sm">
                    <button type="button" onclick="togglePasswordVisibility()" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-700 transition" title="Tampilkan/Sembunyikan Password">
                        <i id="password-eye-icon" class="fa-solid fa-eye text-xs"></i>
                    </button>
                </div>
                <p id="password-error" class="text-red-600 text-xs hidden flex items-center font-medium">
                    <i class="fa-solid fa-circle-exclamation mr-1.5"></i> Kata sandi salah! Silakan coba lagi.
                </p>
                <div class="flex space-x-3 pt-1">
                    <button type="button" onclick="closePasswordModal()" class="w-1/2 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-xl transition text-sm">Batal</button>
                    <button type="submit" class="w-1/2 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-xl transition shadow-md text-sm">Buka Data</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== MODAL PENGATURAN GOOGLE SHEETS ==================== -->
    <div id="sheets-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/65 backdrop-blur-sm hidden p-4 no-print">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 max-w-xl w-full shadow-2xl transform transition-all scale-95 opacity-0 max-h-[90vh] overflow-y-auto" id="sheets-modal-content">
            <div class="flex items-center justify-between border-b border-slate-200 pb-3.5 mb-4">
                <h3 class="text-lg font-bold text-slate-900 flex items-center">
                    <i class="fa-solid fa-table-cells text-amber-600 mr-2.5"></i> Integrasi Google Sheets WDM
                </h3>
                <button onclick="closeSheetsModal()" class="text-slate-400 hover:text-slate-700 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            
            <div class="space-y-4 text-xs text-slate-600">
                <div class="bg-amber-50 border border-amber-200 rounded-xl p-3.5 flex items-start gap-3">
                    <i class="fa-solid fa-circle-check text-amber-600 text-base mt-0.5"></i>
                    <div>
                        <p class="font-bold text-amber-900">URL Google Apps Script Sudah Tertanam Otomatis!</p>
                        <p class="text-amber-700 mt-0.5">Setiap peserta yang mendaftar otomatis dikirimkan langsung ke Google Sheets Anda.</p>
                    </div>
                </div>

                <form onsubmit="saveSheetsUrl(event)" class="space-y-2.5">
                    <label class="block font-bold text-slate-800">URL Web App Google Apps Script Aktif:</label>
                    <input type="url" id="google-sheets-url-input" required placeholder="https://script.google.com/macros/s/...../exec" 
                        class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 font-mono text-[11px] focus:outline-none focus:border-amber-500">
                    <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
                        <button type="button" onclick="resetDefaultSheetsUrl()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-semibold transition">
                            <i class="fa-solid fa-rotate-left mr-1"></i> Kembalikan URL Default
                        </button>
                        <div class="flex space-x-2">
                            <button type="button" onclick="closeSheetsModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-semibold">Tutup</button>
                            <button type="submit" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl font-semibold">Simpan Perubahan</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ==================== HEADER NAVIGASI ==================== -->
    <header class="bg-white/95 backdrop-blur-md border-b border-slate-200 sticky top-0 z-40 shadow-sm no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-3">
            <div class="flex items-center space-x-3.5">
                <a href="#" onclick="switchTab('form'); return false;" class="flex items-center focus:outline-none">
                    <img src="ChatGPT_Image_8_Mei_2026__13.46.42-removebg-preview_2.png" alt="Logo PT Web Digital Marketing" class="h-12 sm:h-14 w-auto object-contain" onerror="this.src='https://placehold.co/180x50/0f172a/d97706?text=PT+WEB+DIGITAL+MARKETING';">
                </a>
                <div class="hidden lg:block pl-3.5 border-l border-slate-200">
                    <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block">Pelatihan Eksklusif WDM</span>
                    <span class="text-xs text-slate-500">Praktik Buat Website dengan AI</span>
                </div>
            </div>

            <!-- Navigation Tabs -->
            <nav class="flex items-center space-x-2">
                <button onclick="switchTab('form')" id="btn-tab-form" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition bg-slate-900 text-white shadow-md flex items-center">
                    <i class="fa-solid fa-pen-to-square mr-1.5"></i><span>Formulir Daftar</span>
                </button>
                <button onclick="switchTab('materi')" id="btn-tab-materi" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition bg-slate-100 text-slate-700 hover:bg-slate-200 flex items-center">
                    <i class="fa-solid fa-book-open mr-1.5 text-amber-600"></i><span>Materi &amp; Sertifikat</span>
                </button>
                <button onclick="switchTab('data')" id="btn-tab-data" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition bg-slate-100 text-slate-700 hover:bg-slate-200 flex items-center">
                    <i id="tab-data-lock-icon" class="fa-solid fa-lock mr-1.5 text-amber-600"></i>
                    <span>Data Peserta</span>
                    <span id="pendaftar-count" class="ml-1.5 px-2 py-0.5 text-xs rounded-full bg-amber-100 text-amber-900 font-bold">0</span>
                </button>
            </nav>
        </div>
    </header>

    <!-- ==================== KONTEN UTAMA ==================== -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">

        <!-- TAB 1: FORMULIR PENDAFTARAN PESERTA -->
        <section id="tab-form" class="space-y-8 no-print">
            <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white p-6 sm:p-10 lg:p-12 shadow-xl border border-slate-800">
                <div class="absolute -right-16 -top-16 w-80 h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -left-16 -bottom-16 w-72 h-72 bg-blue-500/10 rounded-full blur-2xl pointer-events-none"></div>

                <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
                    <div class="max-w-2xl space-y-4">
                        <div class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/10 text-amber-300 border border-white/15 backdrop-blur-sm">
                            <i class="fa-solid fa-laptop-code mr-2 text-amber-400"></i> Pelatihan Resmi • PT Web Digital Marketing (WDM)
                        </div>
                        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-tight">
                            Praktik Membangun <span class="text-amber-400">Aplikasi Website dengan AI</span>
                        </h1>
                        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                            Panduan praktis untuk pemula hingga profesional. Kuasai pembuatan website otomatis tanpa coding dengan bantuan AI, GitHub, dan kustomisasi domain profesional.
                        </p>
                        <div class="flex flex-wrap gap-2.5 pt-2 text-xs font-medium">
                            <span class="bg-white/5 border border-white/10 rounded-xl px-3 py-2 flex items-center"><i class="fa-solid fa-check text-amber-400 mr-2"></i> Tanpa Perlu Coding</span>
                            <span class="bg-white/5 border border-white/10 rounded-xl px-3 py-2 flex items-center"><i class="fa-solid fa-check text-amber-400 mr-2"></i> Ebook &amp; Panduan Lengkap</span>
                            <span class="bg-white/5 border border-white/10 rounded-xl px-3 py-2 flex items-center"><i class="fa-solid fa-check text-amber-400 mr-2"></i> Sertifikat Resmi WDM</span>
                        </div>
                    </div>

                    <div class="bg-white p-5 sm:p-6 rounded-2xl shadow-lg border border-slate-200 self-start lg:self-center shrink-0">
                        <img src="buku_2.png" alt="Buku Cara Mudah Buat Website dengan AI" class="h-36 sm:h-44 w-auto object-contain mx-auto rounded-xl shadow-md" onerror="this.src='https://placehold.co/200x260/0f172a/d97706?text=Buku+Website+AI';">
                    </div>
                </div>
            </div>

            <!-- Kartu Formulir Pendaftaran -->
            <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-sm">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-slate-100 pb-5 mb-7 gap-3">
                    <div>
                        <h2 class="text-xl font-bold text-slate-900 flex items-center">
                            <span class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center mr-3">
                                <i class="fa-solid fa-id-card"></i>
                            </span>
                            Formulir Pendaftaran Pelatihan Website AI
                        </h2>
                        <p class="text-slate-500 text-sm mt-1">Silakan lengkapi biodata dan pilih kategori pendaftaran Anda.</p>
                    </div>
                    <span class="inline-flex items-center px-3 py-1.5 rounded-xl bg-amber-50 text-amber-900 text-xs font-semibold border border-amber-200 self-start">
                        <span class="w-2 h-2 rounded-full bg-amber-500 mr-2 animate-pulse"></span> Terhubung Google Sheets WDM
                    </span>
                </div>

                <form id="registrationForm" onsubmit="handleFormSubmit(event)" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- 1. Nama Lengkap -->
                        <div>
                            <label for="nama" class="block text-sm font-semibold text-slate-700 mb-2">
                                1. Nama Lengkap <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                                    <i class="fa-solid fa-user"></i>
                                </span>
                                <input type="text" id="nama" required placeholder="Masukkan nama lengkap sesuai KTP"
                                    class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition text-sm">
                            </div>
                        </div>

                        <!-- 2. Nomor Telepon / WhatsApp -->
                        <div>
                            <label for="telepon" class="block text-sm font-semibold text-slate-700 mb-2">
                                2. Nomor Telepon / WhatsApp <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-emerald-600">
                                    <i class="fa-brands fa-whatsapp text-base"></i>
                                </span>
                                <input type="tel" id="telepon" required pattern="[0-9+\s\-]{8,18}" placeholder="Contoh: 081234567890"
                                    oninput="this.value = this.value.replace(/[^0-9+\-\s]/g, '')"
                                    class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition text-sm">
                            </div>
                        </div>

                        <!-- 3. Kategori Peserta & Biaya -->
                        <div>
                            <label for="kategori" class="block text-sm font-semibold text-slate-700 mb-2">
                                3. Kategori Peserta &amp; Biaya <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                                    <i class="fa-solid fa-tags"></i>
                                </span>
                                <select id="kategori" required onchange="handleKategoriChange(this.value)"
                                    class="w-full pl-11 pr-10 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition text-sm appearance-none">
                                    <option value="" disabled selected>-- Pilih Kategori Peserta --</option>
                                    <option value="Umum (Rp 500.000)">Umum — Rp 500.000</option>
                                    <option value="Pelajar / Mahasiswa (Rp 250.000)">Pelajar / Mahasiswa — Rp 250.000</option>
                                    <option value="UMKM (Rp 300.000)">UMKM — Rp 300.000</option>
                                    <option value="Marbot & Yatim Piatu (Gratis)">Marbot &amp; Yatim Piatu — Gratis</option>
                                </select>
                                <span class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-slate-400">
                                    <i class="fa-solid fa-chevron-down text-xs"></i>
                                </span>
                            </div>
                            <p id="kategori-info" class="text-xs text-amber-800 font-medium mt-1.5 hidden"></p>
                        </div>

                        <!-- 4. Pilihan Bidang Usaha / Kebutuhan -->
                        <div>
                            <label for="usaha" class="block text-sm font-semibold text-slate-700 mb-2">
                                4. Bidang Usaha / Kebutuhan Website <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                                    <i class="fa-solid fa-store"></i>
                                </span>
                                <select id="usaha" required onchange="toggleCustomUsaha(this.value)"
                                    class="w-full pl-11 pr-10 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition text-sm appearance-none">
                                    <option value="" disabled selected>-- Pilih Bidang Usaha --</option>
                                    <option value="Kuliner & Makanan/Minuman">Kuliner & Makanan/Minuman</option>
                                    <option value="Fashion & Konveksi">Fashion & Konveksi</option>
                                    <option value="Kerajinan / Kriya">Kerajinan / Kriya</option>
                                    <option value="Jasa & Layanan Profesional">Jasa & Layanan Profesional</option>
                                    <option value="Toko Online / E-Commerce">Toko Online / E-Commerce</option>
                                    <option value="Company Profile Perusahaan">Company Profile Perusahaan</option>
                                    <option value="Portofolio Pribadi / Freelance">Portofolio Pribadi / Freelance</option>
                                    <option value="Lainnya">Lainnya (Isi Manual)</option>
                                </select>
                                <span class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-slate-400">
                                    <i class="fa-solid fa-chevron-down text-xs"></i>
                                </span>
                            </div>
                            <div id="custom-usaha-wrapper" class="hidden mt-2.5">
                                <input type="text" id="usaha_manual" placeholder="Tuliskan nama/jenis bidang usaha Anda..."
                                    class="w-full px-4 py-2.5 bg-amber-50/50 border border-amber-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-amber-500 transition text-sm">
                            </div>
                        </div>

                        <!-- 5. Pekerjaan Saat Ini -->
                        <div>
                            <label for="pekerjaan" class="block text-sm font-semibold text-slate-700 mb-2">
                                5. Pekerjaan Saat Ini <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                                    <i class="fa-solid fa-briefcase"></i>
                                </span>
                                <select id="pekerjaan" required
                                    class="w-full pl-11 pr-10 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:outline-none focus:border-amber-500 transition text-sm appearance-none">
                                    <option value="" disabled selected>-- Pilih Pekerjaan Saat Ini --</option>
                                    <option value="Pelaku UMKM / Wirausaha">Pelaku UMKM / Wirausaha</option>
                                    <option value="Karyawan Swasta">Karyawan Swasta</option>
                                    <option value="Pelajar / Mahasiswa">Pelajar / Mahasiswa</option>
                                    <option value="Ibu Rumah Tangga">Ibu Rumah Tangga</option>
                                    <option value="Freelancer / Kreator Konten">Freelancer / Kreator Konten</option>
                                    <option value="Pencari Kerja">Pencari Kerja</option>
                                    <option value="Lainnya">Lainnya</option>
                                </select>
                                <span class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-slate-400">
                                    <i class="fa-solid fa-chevron-down text-xs"></i>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- 6. Alamat Lengkap -->
                    <div>
                        <label for="alamat" class="block text-sm font-semibold text-slate-700 mb-2">
                            6. Alamat Lengkap <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute top-3.5 left-4 pointer-events-none text-slate-400">
                                <i class="fa-solid fa-location-dot"></i>
                            </span>
                            <textarea id="alamat" rows="3" required placeholder="Tuliskan Nama Jalan / Dusun, RT/RW, Desa/Kelurahan, Kecamatan, Kabupaten/Kota..."